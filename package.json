{
  "name": "cmfas-exams",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static study site (guides, quizzes, mock exams) for the Singapore CMFAS / IBF capital markets exams: RES 12B, FMRP and CM-SIP.",
  "scripts": {
    "gen": "node scripts/build-banks.mjs && node scripts/build-content.mjs",
    "predev": "npm run gen",
    "dev": "astro dev",
    "prebuild": "npm run gen",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:parser": "node scripts/test-parser.mjs",
    "verify": "npm run test:parser && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
